rules_version = '2';

// Reglas por rol para warplux / telares.
// NO están desplegadas todavía: la consola sigue en modo abierto a propósito
// mientras se prueba el flujo completo. Desplegar con:
//   firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    function emailActual() {
      return request.auth.token.email;
    }

    function filaUsuario() {
      return get(/databases/$(database)/documents/usuarios_roles/$(emailActual()));
    }

    function tieneRol() {
      return request.auth != null && exists(/databases/$(database)/documents/usuarios_roles/$(emailActual()));
    }

    function rolActual() {
      return tieneRol() ? filaUsuario().data.rol : null;
    }

    function esMaestra() {
      return rolActual() == 'maestra_tejedora';
    }

    function esTejedora() {
      return rolActual() == 'tejedor' || esMaestra();
    }

    function esUrdidora() {
      return rolActual() == 'urdidor' || esMaestra();
    }

    function esHiladora() {
      // sin alcance por mesa: cualquier hilador puede elegir o crear su mesa
      return rolActual() == 'hilador' || esTejedora();
    }

    match /proyectos/{proyectoId} {
      allow read: if true;
      allow create, delete: if esMaestra();
      allow update: if esMaestra() || esUrdidora(); // urdidor ajusta apariencia/patrones del telar

      match /pasadas/{pasadaId} {
        allow read: if true;
        // hilador puede crear filas colaborativas (mesas) nuevas; estructura institucional es de maestra/tejedora
        allow create: if esMaestra() || esTejedora() ||
          (rolActual() == 'hilador' && request.resource.data.tipo == 'colaborativa');
        allow update: if esMaestra() || esTejedora() || rolActual() == 'hilador';
        allow delete: if esMaestra();

        match /nudos/{nudoId} {
          // público solo ve nudos tejidos; crudo queda reservado a tejedoras/maestra
          allow read: if resource.data.estado == 'tejido' || esTejedora();
          allow create, update: if esHiladora();
          allow delete: if esTejedora();
        }
      }

      match /plantillas/{plantillaId} {
        allow read: if true;
        allow write: if esUrdidora();
      }

      match /historial/{entradaId} {
        allow read: if esMaestra();
        allow create: if tieneRol();
        allow update, delete: if false; // bitácora no destructiva
      }
    }

    match /usuarios_roles/{email} {
      allow read: if request.auth != null && (emailActual() == email || esMaestra());
      allow write: if esMaestra();
    }
  }
}
