rules_version = '2';

// Reglas por rol para warplux / telares.
// NO están desplegadas todavía: la consola sigue en modo abierto a propósito
// mientras se prueba el flujo completo. Desplegar con:
//   firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    function emailActual() {
      return request.auth.token.email;
    }

    function filaUsuario() {
      return get(/databases/$(database)/documents/usuarios_roles/$(emailActual()));
    }

    function tieneRol() {
      return request.auth != null && exists(/databases/$(database)/documents/usuarios_roles/$(emailActual()));
    }

    function rolActual() {
      return tieneRol() ? filaUsuario().data.rol : null;
    }

    // urdidor puede todo; tejedor hereda de urdidor; hilador hereda de tejedor.
    function esUrdidor() {
      return rolActual() == 'urdidor';
    }

    function esTejedor() {
      return rolActual() == 'tejedor' || esUrdidor();
    }

    function esHilador() {
      return rolActual() == 'hilador' || esTejedor();
    }

    match /proyectos/{proyectoId} {
      allow read: if true;
      allow create, delete: if esUrdidor();
      allow update: if esTejedor(); // tejedor ajusta estiloPorCategoria, urdidor ajusta todo

      match /pasadas/{pasadaId} {
        allow read: if true;
        // solo tejedor/urdidor crean filas y prenden/apagan su visibilidad; hilador solo llena nudos
        allow create, update: if esTejedor();
        allow delete: if esTejedor();

        match /nudos/{nudoId} {
          // público solo ve nudos tejidos; crudo queda reservado a tejedor/urdidor
          allow read: if resource.data.estado == 'tejido' || esTejedor();
          allow create, update: if esHilador();
          allow delete: if esTejedor();
        }
      }

      match /estilos/{estiloId} {
        allow read: if true; // tejedor necesita leerlos para elegir
        allow write: if esUrdidor(); // solo urdidor cura la lista finita
      }

      match /historial/{entradaId} {
        allow read: if esUrdidor();
        allow create: if tieneRol();
        allow update, delete: if false; // bitácora no destructiva
      }
    }

    match /usuarios_roles/{email} {
      allow read: if request.auth != null && (emailActual() == email || esUrdidor());
      allow write: if esUrdidor();
    }
  }
}
